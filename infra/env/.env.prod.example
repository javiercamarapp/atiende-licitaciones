# Copia este archivo a infra/compose/.env (NUNCA lo commitees con valores
# reales -- infra/compose/.env ya está en .gitignore) y completa TODOS los
# valores marcados como obligatorios antes de `docker compose up`.
#
# Este archivo resuelve las ${VARIABLE} de infra/compose/docker-compose.prod.yml
# -- no todas estas variables llegan a cada contenedor: revisa el bloque
# `environment:` de cada servicio en ese YAML para ver exactamente cuáles usa.
#
# Verificado end-to-end contra Docker real el 2026-09-08 (ver
# docs/logs/infra-docker-verificacion.log): con estos valores completados
# (de prueba, nunca reales) el stack completo (postgres, migrate, api,
# worker, web) arranca sano.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=atiende
POSTGRES_PASSWORD=cambia-esta-contrasena-en-produccion
POSTGRES_DB=atiende_licitaciones

# ---------------------------------------------------------------------------
# Dominios y TLS (Caddy)
# ---------------------------------------------------------------------------
WEB_DOMAIN=app.tudominio.com
API_DOMAIN=api.tudominio.com
ACME_EMAIL=tu-correo@tudominio.com

# ---------------------------------------------------------------------------
# apps/api -- ver apps/api/.env.example para la explicación completa de cada
# una. OBLIGATORIAS (la API no arranca sin ellas): JWT_SECRET,
# TOTP_ENCRYPTION_KEY, MAIL_LINK_SECRET, PLATFORM_API_KEY.
# ---------------------------------------------------------------------------
JWT_SECRET=cambia-este-secreto-en-produccion-min-32-caracteres
TOTP_ENCRYPTION_KEY=cambia-esta-clave-en-produccion-min-16-caracteres
STEP_UP_WINDOW_MINUTES=5
MAIL_LINK_SECRET=cambia-esta-llave-en-produccion-min-16-caracteres
PLATFORM_API_KEY=genera-una-clave-robusta-openssl-rand-base64-48
RATE_LIMIT_PROFILE=
SENTRY_DSN=

# Correo transaccional (@atiende/mail) -- opcionales, sin ellas el
# provider real declara "not_configured" y usa "capture" (nada sale a
# Internet). Ver packages/mail/README.md.
MAIL_FROM=soporte@tudominio.com
CONTACT_INBOX=
MAIL_PROVIDER=
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
RESEND_WEBHOOK_SECRET=
REQUIRE_EMAIL_VERIFICATION=true

# Opcional: ruta local donde CaptureProvider persiste a disco los correos
# "enviados" cuando MAIL_PROVIDER no apunta a un proveedor real (ver
# packages/mail/src/provider/capture-provider.ts). Vacío = solo en memoria.
MAIL_CAPTURE_FILE=

# Opcional: dominio público adicional (sin protocolo) que puede recibir un
# enlace http:// en un correo sin caer al fallback (ver
# packages/mail/src/security/safe-url.ts). Vacío en el caso normal (este
# despliegue sirve HTTPS real vía Caddy).
MAIL_PUBLIC_APP_HOST=

# Login con Google (OIDC) -- sin estas 3, /auth/google/* responde 503
# honesto (BLOQUEADO_EXTERNO), nunca rompe el resto de la API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Canal adicional de WhatsApp (@atiende/whatsapp) -- opcionales, sin ellas
# el provider real de Meta declara "not_configured" (solo el correo sigue
# notificando). Ver packages/whatsapp/README.md.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcionales, con default seguro en código (ver
# packages/whatsapp/src/provider/factory.ts/meta-cloud-provider.ts).
WHATSAPP_API_VERSION=
WHATSAPP_DEFAULT_LANGUAGE=
WHATSAPP_CAPTURE_FILE=

# ---------------------------------------------------------------------------
# apps/worker
# ---------------------------------------------------------------------------
WORKER_ID=
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_MS=15000
# apps/worker/src/config.ts: máximo de jobs concurrentes por proceso.
WORKER_MAX_CONCURRENT_JOBS=1
WORKER_SHUTDOWN_TIMEOUT_MS=30000
LOG_LEVEL=info
WORKER_SCHEDULE_JSON=
OPENAI_API_KEY=
# Ronda 6 (apps/worker/src/agents/kill-switch.ts, handlers/run-agent.ts):
# kill-switch por agente (lista separada por comas) y presupuesto USD/org de
# run_agent -- ambas con default seguro en código.
WORKER_DISABLED_AGENTS=
WORKER_AGENT_BUDGET_USD_PER_ORG=5

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
IMAGE_TAG=local
