{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // REQ-181..195: `@atiende/mail` se consume como FUENTE TypeScript
    // (`"main": "./src/index.ts"`, igual que @atiende/db), y sus plantillas
    // son `.tsx` (React Email). Sin estas dos opciones, `tsc` de apps/api
    // falla con TS6142 al resolverlas. No afecta a `apps/api/src`, que no
    // tiene ni un solo archivo `.tsx`.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src", "test"]
}
