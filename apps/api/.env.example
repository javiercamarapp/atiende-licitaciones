# Copia este archivo a .env y ajusta valores (nunca commitees .env real).

# Puerto HTTP de la API.
PORT=3000

# Secreto para firmar JWT (HS256). Genera uno robusto en producción, p.ej.:
#   openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-en-produccion-min-32-caracteres

# Cadena de conexión a la base de datos:
# - Vacío o `pglite://memory` (o simplemente sin definir): PGlite en memoria
#   (desarrollo/tests, se pierde al reiniciar el proceso).
# - `pglite:///ruta/a/directorio`: PGlite con persistencia en disco local.
# - `postgres://usuario:password@host:5432/basededatos`: Postgres real
#   (producción), usando el driver `pg`.
DATABASE_URL=pglite://memory

# development | test | production. En production, los errores 500 no filtran
# stack trace ni mensajes internos en la respuesta.
NODE_ENV=development

# Si es "true", la API NO aplica migraciones automáticamente al arrancar
# (útil en producción si las migraciones se aplican en un paso de despliegue
# separado, ver packages/db/README.md).
SKIP_MIGRATIONS=false

# Directorio local donde se guardan archivos subidos (p.ej. documentos de
# empresa). Ronda 2: almacenamiento en disco con hash sha256, sin S3/objeto
# remoto. Relativo al cwd del proceso, o ruta absoluta.
STORAGE_DIR=.data/storage

# Orígenes permitidos para CORS, separados por coma (ej.
# "https://app.atiende.mx,https://admin.atiende.mx"). Vacío = ningún origen
# cross-site permitido (más seguro por defecto; ajusta en despliegue real).
CORS_ORIGINS=

# Clave de API de plataforma para autenticar servicios internos (p.ej.
# apps/worker) contra POST /internal/tenders/ingest. Genera una robusta en
# producción; sin esta variable, el endpoint de ingesta interna rechaza toda
# solicitud (falla cerrado, nunca abierto).
PLATFORM_API_KEY=
