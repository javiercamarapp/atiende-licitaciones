# Copia este archivo a .env y ajusta valores (nunca commitees .env real).

# Cadena de conexión a la base de datos (mismo formato que apps/api, ver
# packages/db/README.md):
# - Vacío o `pglite://memory` (o sin definir): PGlite en memoria (desarrollo).
# - `pglite:///ruta/a/directorio`: PGlite con persistencia en disco local.
# - `postgres://usuario:password@host:5432/basededatos`: Postgres real.
DATABASE_URL=pglite://memory

# development | test | production.
NODE_ENV=development

# Si es "true", el worker NO aplica migraciones automáticamente al arrancar.
SKIP_MIGRATIONS=false

# Identificador de este proceso worker (locked_by en `jobs`). Por defecto se
# genera uno único con el PID; en producción con varios procesos conviene
# fijarlo explícitamente (p. ej. al nombre del pod/contenedor) para que los
# logs y `jobs.locked_by` sean legibles.
WORKER_ID=

# Cada cuánto sondea la cola cuando no hay jobs disponibles.
WORKER_POLL_INTERVAL_MS=1000

# Duración del lease de un job "running" antes de considerarse abandonado y
# recuperable por otro worker (ver README §Arquitectura, "lease expirado").
WORKER_LEASE_SECONDS=60

# Cada cuánto se refresca (heartbeat) el lease de un job en curso. Debe ser
# bastante menor que WORKER_LEASE_SECONDS (regla general: 1/4).
WORKER_HEARTBEAT_INTERVAL_MS=15000

# Cuánto espera el cierre ordenado (SIGTERM/SIGINT) a que termine el job en
# curso antes de continuar de todas formas (ver README §Pendientes).
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Nivel de log de pino: trace|debug|info|warn|error|fatal|silent.
LOG_LEVEL=info

# JSON opcional para sobreescribir la cadencia por fuente del scheduler
# (ver src/scheduler/schedule-config.ts DEFAULT_SCHEDULES para el formato y
# los valores por defecto documentados por fuente).
# Ejemplo: '[{"sourceId":"dof","intervalMs":3600000}]'
WORKER_SCHEDULE_JSON=

# Base de apps/api para el cliente de ingesta interno
# (POST /internal/tenders/ingest, ver apps/api/src/modules/tenders/internal-ingest.routes.ts).
API_BASE_URL=http://localhost:3000

# Clave compartida worker<->api para autenticar ese endpoint interno
# (cabecera `X-Platform-Api-Key`). MISMO NOMBRE de variable que usa apps/api
# (ver apps/api/.env.example: PLATFORM_API_KEY) — configura el mismo valor
# en ambos procesos. PENDIENTE: definir cómo se distribuye y rota esta clave
# en producción (no es una api_keys de organización: esas son siempre por
# tenant, ver packages/db/migrations/0002_core_tenancy.sql).
PLATFORM_API_KEY=

# Si se define, el handler run_agent usa OpenAIResponsesProvider real en vez
# de FakeProvider. PENDIENTE (ver README §Pendientes): esta ronda NO ejercitó
# la integración real contra OpenAI con credenciales de producción.
OPENAI_API_KEY=
